# === Facebook ===
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_VERIFY_TOKEN=your_custom_verify_token
FB_APP_SECRET=your_app_secret

# === OpenRouter ===
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL_FREE=openai/gpt-oss-120b:free
OPENROUTER_MODEL_PAID=deepseek/deepseek-chat
MODEL_FALLBACK_COOLDOWN=120

# === Google Sheets ===
GOOGLE_SHEETS_CREDENTIALS=credentials.json
GOOGLE_SHEET_NAME=FB Auto Reply Log

# === Bot Settings ===
REPLY_DELAY_SECONDS=15
SERVER_PORT=8886

# === Auto Like/React ===
AUTO_LIKE_ENABLED=true
AUTO_LIKE_REACTION_TYPE=LIKE

# === Dashboard ===
RECENT_COMMENTS_LIMIT=10

# === Auto-refresh UI (giây, đặt 0 để tắt) ===
# Giảm xuống để theo dõi real-time hơn, tăng lên để giảm tải server
HOMEPAGE_REFRESH_SECONDS=60
DASHBOARD_REFRESH_SECONDS=30
WORKER_REFRESH_SECONDS=3
